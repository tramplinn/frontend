# Адрес бэкенда для дев-прокси Vite. В проде фронт и API стоят за одним доменом.
BACKEND_ORIGIN=http://localhost:8000

# Базовый префикс API. Относительный путь => запросы идут через тот же origin.
VITE_API_BASE_URL=/api/v1

# Runtime-параметры production-контейнера.
COMPOSE_PROJECT_NAME=tramplin-frontend-local
API_UPSTREAM=http://tramplin-staging-api:8000
EDGE_NETWORK=tramplin-edge
WEB_NETWORK_ALIAS=tramplin-web
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080
CLIENT_MAX_BODY_SIZE=12m
